# Generate with: openssl rand -base64 48 | tr -d '\n'
SHELLBELL_OWNER_BOOTSTRAP_TOKEN=replace-with-a-random-owner-token

# Generate together with: npx --yes web-push generate-vapid-keys --json
SHELLBELL_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
SHELLBELL_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
SHELLBELL_VAPID_SUBJECT=mailto:owner@example.com

SHELLBELL_HISTORY_RETENTION_DAYS=14
SHELLBELL_PORT=8080

# Keep false behind HTTPS/Caddy. Set true only for explicit localhost development.
SHELLBELL_INSECURE_LOCAL_HTTP=false
RUST_LOG=shellbell_relay=info,tower_http=info
